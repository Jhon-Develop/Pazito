# Copia a .env.docker. Solo desarrollo local; no reutilices estos valores en producción.
# MySQL local del compose:
PAZITO_DATABASE_URL=mysql://pazito:pazito_dev_only@mysql:3306/pazito
PAZITO_SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
# URL pública que el navegador usará para llamar al backend.
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
